import { Adapter } from 'capkit'; // Integrate with capkit
import { getAuth } from './auth.js';
import { getCache } from './cache.js';
import { audit } from './audit.js';

/**
 * {{platform}} Adapter
 * Generated by connector-starter
 */

export class {{platform | capitalize}}Adapter implements Adapter {
  private auth: any;
  private cache: any;

  async connect() {
    this.auth = await getAuth();
    this.cache = getCache();
    audit('connected', { platform: '{{platform}}' });
  }

  async fetch(endpoint: string, params: any) {
    // Platform-specific API call
    const key = await this.auth.getKey();
    // TODO: Implement {{platform}} API
    const data = await fetch(`https://{{platform}}.com/api/${endpoint}`, {
      headers: { Authorization: `Bearer ${key}` },
    }).then(r => r.json());
    return data;
  }

  async post(endpoint: string, data: any) {
    // Platform-specific post
    audit('post', { endpoint });
    // TODO: Implement
    return { success: true };
  }

  async disconnect() {
    audit('disconnected');
  }
}
